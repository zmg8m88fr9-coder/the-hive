{
  "name": "Trade",
  "type": "object",
  "properties": {
    "brain_id": {
      "type": "string",
      "description": "ID of the brain that made the trade (e.g. THE_BRAIN, APEX)"
    },
    "ticker": {
      "type": "string",
      "description": "Trading symbol (e.g. NVDA, BTC, EURUSD)"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "stock",
        "crypto",
        "forex",
        "futures",
        "options",
        "etf"
      ],
      "description": "Asset class of the instrument traded"
    },
    "action": {
      "type": "string",
      "enum": [
        "BUY",
        "SHORT"
      ],
      "description": "Direction of the trade"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "cancelled"
      ],
      "default": "open",
      "description": "Current status of the trade"
    },
    "play_type": {
      "type": "string",
      "enum": [
        "momentum",
        "short_squeeze",
        "bull_flag",
        "bear_flag",
        "scalp",
        "breakout",
        "reversal",
        "mean_reversion",
        "gamma_squeeze",
        "trend_follow",
        "news_catalyst",
        "liquidity_sweep",
        "pairs_trade",
        "stat_arb",
        "regime_switch",
        "iv_crush",
        "carry_trade",
        "stop_hunt",
        "portfolio_hedge",
        "transfer_play"
      ],
      "description": "The type of trade setup/play \u2014 expanded with RL-inspired strategies"
    },
    "rl_method": {
      "type": "string",
      "enum": [
        "DQN",
        "PPO",
        "DDPG",
        "RRL",
        "A2C",
        "Q-Learning",
        "SARSA",
        "Actor-Critic",
        "Model-Based"
      ],
      "description": "Underlying RL algorithm driving this trade decision"
    },
    "reward_signal": {
      "type": "string",
      "enum": [
        "sharpe_ratio",
        "profit_based",
        "utility",
        "differential_sr",
        "sortino",
        "composite"
      ],
      "description": "Reward function optimised for this trade"
    },
    "entry_price": {
      "type": "number",
      "description": "Price at which the trade was entered"
    },
    "exit_price": {
      "type": "number",
      "description": "Price at which the trade was closed (null if still open)"
    },
    "quantity": {
      "type": "number",
      "description": "Number of units/shares/contracts"
    },
    "pnl": {
      "type": "number",
      "description": "Profit or loss in dollars (null if still open)"
    },
    "pnl_pct": {
      "type": "number",
      "description": "Profit or loss percentage (null if still open)"
    },
    "confidence": {
      "type": "number",
      "description": "Brain confidence score 0-1 at trade entry"
    },
    "reasoning": {
      "type": "string",
      "description": "Brain's reasoning for the trade"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the trade was opened"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the trade was closed (null if open)"
    }
  },
  "required": [
    "brain_id",
    "ticker",
    "action",
    "status",
    "entry_price"
  ]
}